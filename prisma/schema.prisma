// FILE: prisma/schema.prisma
//
// ─────────────────────────────────────────────────────────────────
// ANU Education AI Assistant — database schema
//
// Design principles:
//   1. Conversation is channel-agnostic (web widget OR WhatsApp) —
//      one model handles both via `source`, so a student who starts
//      on the website and continues on WhatsApp has ONE conversation
//      record, not two.
//   2. Lead scoring reuses the SAME 0–100 scale as the Study Abroad
//      Readiness Assessment (lib/assessment/scoreEngine.ts) so a
//      counsellor's CRM view can compare assessment leads and chat
//      leads on one consistent scale.
//   3. Every escalation is logged as its own row (HandoffEvent) —
//      not just a boolean flag — so you can measure which trigger
//      fires most often and improve the prompt/knowledge base
//      accordingly over time.
//   4. Soft-delete via `deletedAt` on Conversation for GDPR-style
//      data requests, not hard deletes — preserves lead history
//      for CRM/analytics while allowing "forget me" compliance.
//   5. Free demo bookings (DemoBooking) are their own model, not a
//      status flag on Conversation — a single conversation can lead
//      to a booking, a reschedule (new row), and a cancellation,
//      and keeping each as its own row preserves that history
//      instead of overwriting it.
// ─────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════════════════════════════════════════════
// LEAD — canonical CRM identity (Phase 3C / C1)
// ═════════════════════════════════════════════════════════════════
//
// One Lead = one real person/student, shared across the website chat
// and WhatsApp. Each channel keeps its OWN Conversation row (channel-
// aware, source-scoped reuse — see buildPhoneLookupWhere), but all of
// them point at the same Lead, so the CRM can answer "does this
// student exist?" with one canonical profile.
//
// Matching order (lib/lead/lead.identity.service.ts):
//   1. normalized phone → 2. normalized email → 3. explicit Lead ID
//   → 4. create new. phone/email both nullable here: WhatsApp inbound
//   only ever guarantees a phone; the website only guarantees a
//   sessionId until details are shared.
//
// DELIBERATELY NOT @unique on phone: real data contains repeated
// numbers across sessions; a strict unique would force risky merges.
// email IS @unique — one person, one mailbox — with a race-safe
// create (P2002 → re-find). identitySource records which channel
// created the Lead (informational only; a Lead found by phone/email
// later is never re-labelled).
// ═════════════════════════════════════════════════════════════════

enum LeadIdentitySource {
  WEB
  WHATSAPP
}

model Lead {
  id             String              @id @default(cuid())
  name           String?
  phone          String? // E.164, e.g. "+919428186817"
  email          String?             @unique
  identitySource LeadIdentitySource?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations        Conversation[]
  demoBookings         DemoBooking[]
  portalAccessRequests PortalAccessRequest[]
  admissionEnrollments AdmissionEnrollment[]

  @@index([phone])
  @@index([identitySource])
}

// ═════════════════════════════════════════════════════════════════
// CONVERSATION
// ═════════════════════════════════════════════════════════════════

enum ConversationSource {
  WEB // chat widget on anuedu.in
  WHATSAPP // WhatsApp Business API
}

enum ConversationStatus {
  ACTIVE // AI is actively responding
  HANDED_OFF // escalated to a human counsellor
  CLOSED // conversation ended (by user or timeout)
  ARCHIVED // soft-closed after long inactivity
}

model Conversation {
  id     String             @id @default(cuid())
  source ConversationSource
  status ConversationStatus @default(ACTIVE)

  // Identity — at least one of these should be populated.
  // phone is the WhatsApp-canonical identifier; sessionId covers
  // anonymous web visitors before they share contact details.
  phone     String? // E.164 format, e.g. "+919428186817"
  sessionId String? @unique // web widget session token
  name      String? // captured mid-conversation once known
  email     String?

  // Canonical CRM identity (C1). Nullable: anonymous web visitors keep
  // `null` until they share a phone or email. One Lead may own MANY
  // conversations (a WEB row and a WHATSAPP row for the same student).
  // This is a CRM LINK ONLY — it never participates in conversation
  // reuse (that stays phone/sessionId, source-scoped as documented).
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Page context — which anuedu.in page the chat opened from.
  // Useful for understanding intent (e.g. opened from /test-prep/gmat
  // strongly suggests a GMAT question) and for attribution reporting.
  sourcePage String?

  // Lead scoring — same 0–100 scale as scoreEngine.ts in the
  // assessment tool, so counsellors see one consistent number
  // across both lead sources in the CRM.
  leadScore Int?
  leadTier  String? // "READY" | "ALMOST" | "EARLY" — mirrors ResultTier

  // Counsellor ownership — nullable. null = UNASSIGNED (AI may
  // respond). Non-null = ASSIGNED or HANDED_OFF (AI must not reply).
  assignedCounsellorId String?
  assignedCounsellor   Staff?  @relation("StaffConversations", fields: [assignedCounsellorId], references: [id], onDelete: SetNull)

  // Relations
  messages             Message[]
  handoffEvents        HandoffEvent[]
  leadContext          LeadContext?
  demoBookings         DemoBooking[]
  portalAccessRequests PortalAccessRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete for data-request compliance

  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([assignedCounsellorId])
  @@index([leadId])
}

// ═════════════════════════════════════════════════════════════════
// MESSAGE
// ═════════════════════════════════════════════════════════════════

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM // logged for audit/debug — not shown to the user
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String

  // Tool-call trace — records which knowledge lookup(s) the
  // assistant used to answer this message, if any. Stored as JSON
  // for flexibility (tool name + args + result summary), primarily
  // for debugging hallucination reports and improving the knowledge
  // layer over time.
  toolCalls Json?

  // Token usage for cost tracking / rate-limit accounting.
  promptTokens     Int?
  completionTokens Int?

  // Provider identity (C1) — the message id granted by the channel
  // (Meta wamid / Evolution key.id / Chatwoot external id) and its
  // delivery status. Intentionally nullable and NOT yet auto-populated:
  // C2 (cross-channel dedup) and B4 (outbound status tracking) will
  // write these via the same adapter seams. Absent here means
  // "web-generated message or provider unknown".
  providerId        String?
  providerMessageId String?
  providerStatus    String?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

// ═════════════════════════════════════════════════════════════════
// HANDOFF EVENT
// One row per escalation — NOT a boolean flag on Conversation —
// so trigger frequency can be analysed and the prompt/knowledge
// base improved based on real data.
// ═════════════════════════════════════════════════════════════════

enum HandoffTrigger {
  EXPLICIT_HUMAN_REQUEST
  PRICING_NEGOTIATION
  VISA_REJECTION_DISTRESS
  URGENT_TIMELINE
  COMPLAINT
  LEGAL_MEDICAL_QUESTION
  LOW_CONFIDENCE_ANSWER
  REPEATED_UNSATISFIED_QUESTION
  MANUAL_OVERRIDE // counsellor manually pulled the conversation
}

model HandoffEvent {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  trigger       HandoffTrigger
  triggerDetail String?

  // Whether a counsellor actually picked up the handoff, and when.
  acknowledgedAt DateTime?
  acknowledgedBy String? // counsellor identifier/email

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([trigger])
}

// ═════════════════════════════════════════════════════════════════
// LEAD CONTEXT
// One-to-one with Conversation. Mirrors the LeadContext type in
// lib/assessment/types.ts so the chat assistant and the readiness
// assessment produce comparable, mergeable lead records.
// ═════════════════════════════════════════════════════════════════

model LeadContext {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Populated progressively as the assistant learns about the student —
  // never required upfront, filled in opportunistically during chat.
  goal          String? // e.g. "study" | "pr" | "work" | "research"
  targetCountry String?
  targetCourse  String? // e.g. "IELTS Academic", "GMAT"
  englishLevel  String?
  budgetRange   String?
  timeline      String? // e.g. "within 1 month", "just exploring"

  // "Fall 2026", "September intake" — distinct from `timeline` above,
  // which captures readiness/urgency ("ASAP", "just exploring")
  // rather than a specific academic term. Populated by
  // lib/lead/leadExtractor.ts's extractIntake().
  intake String?

  biggestChallenge String?

  // Links this chat lead to a completed Study Abroad Readiness
  // Assessment result, if the same student did both — avoids
  // treating one person as two separate leads in the CRM.
  linkedAssessmentId String?

  updatedAt DateTime @updatedAt

  @@index([targetCountry])
  @@index([targetCourse])
}

// ═════════════════════════════════════════════════════════════════
// DEMO BOOKING
// A student requesting/confirming a free demo class. Its own model
// rather than a status flag on Conversation — one conversation can
// produce multiple bookings over time (a reschedule is a new row,
// not an overwrite), preserving full booking history for the CRM.
// ═════════════════════════════════════════════════════════════════

enum DemoBookingStatus {
  PENDING
  CONFIRMED
  ATTENDED
  NO_SHOW
  CANCELLED
}

// ═════════════════════════════════════════════════════════════════
// S6-D2-B — COUNSELLOR-CONTROLLED FREE DEMO ATTENDANCE
//
// Audit action taken on a DemoBooking. Only an authenticated human
// counsellor/admin may change a booking's attendance status — NEITHER
// the AI (which may classify a student's words as a signal) NOR the
// student (whose text never writes these) mutate DemoBooking.status.
// These rows are the immutable, additive audit trail behind the
// booking's `status` field. Do NOT repurpose AdmissionEvent for
// demo attendance — attendance truth belongs to DemoBooking.
// ═════════════════════════════════════════════════════════════════
enum DemoBookingEventAction {
  MARKED_ATTENDED
  MARKED_NO_SHOW
  CANCELLED
}

model DemoBooking {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Canonical CRM identity (C1) — the Lead this booking belongs to,
  // resolved via the conversation. Nullable; set opportunistically.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Snapshotted at booking time, intentionally duplicating
  // Conversation.name/phone/email rather than reading them live —
  // a booking record should reflect what was true when it was made,
  // even if the conversation's contact details are corrected later.
  name  String?
  phone String?
  email String?

  course         String?
  preferredBatch String?
  preferredDate  DateTime?
  status         DemoBookingStatus @default(PENDING)
  notes          String?

  // Set once a reminder (WhatsApp/email via Resend) has been sent
  // for this booking — prevents sending a duplicate reminder if a
  // scheduled job runs more than once before preferredDate.
  reminderSentAt DateTime?

  // ── S6-D2-B — COUNSELLOR-CONTROLLED DEMO ATTENDANCE ─────────────
  // Atomic, human-verified attendance truth. Written ONLY by an
  // authenticated counsellor/admin via the attendance service (never by
  // AI, never by student text). Timing fields are set exactly once by
  // the transition that applies them; they never toggle. The verified-by
  // staff id + note are set on the same transition. The status life is
  // audited immutably by DemoBookingEvent rows.
  attendedAt                  DateTime?
  noShowAt                    DateTime?
  cancelledAt                 DateTime?
  attendanceNote              String?
  // The authenticated staff who verified the outcome (COUNSELLOR/ADMIN).
  // Server-derived from StaffIdentity — never browser-supplied.
  attendanceVerifiedByStaffId String?
  attendanceVerifiedByStaff   Staff?    @relation("StaffDemoAttendanceVerified", fields: [attendanceVerifiedByStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  events    DemoBookingEvent[]

  @@index([conversationId])
  @@index([phone])
  @@index([status])
  @@index([preferredDate])
  @@index([leadId])
  @@index([attendanceVerifiedByStaffId])
}

// ═════════════════════════════════════════════════════════════════
// S6-D2-B — DEMO BOOKING ATTENDANCE AUDIT EVENT
//
// Immutable, additive audit history for every attended/no-show/cancel
// decision. Mirrors the AdmissionEvent idempotency contract: events
// sharing (demoBookingId, eventKey) collapse to ONE row, so concurrent
// or repeated issuers of the SAME logical action write a single event.
// These rows never carry AI reasoning or internal prompts.
// ═════════════════════════════════════════════════════════════════
model DemoBookingEvent {
  id String @id @default(cuid())

  demoBookingId String
  demoBooking   DemoBooking @relation(fields: [demoBookingId], references: [id], onDelete: Cascade)

  action DemoBookingEventAction

  // Audit payload: what (action + note), who (staffId, server-derived),
  // when (createdAt), and the status walk.
  previousStatus DemoBookingStatus?
  nextStatus     DemoBookingStatus

  staffId String?
  staff   Staff?  @relation("StaffDemoAttendanceAction", fields: [staffId], references: [id], onDelete: SetNull)

  note String?

  // Idempotency backstop — identical to AdmissionEvent.eventKey semantics.
  eventKey String?

  createdAt DateTime @default(now())

  @@unique([demoBookingId, eventKey])
  @@index([demoBookingId, createdAt])
  @@index([action])
}

// ═════════════════════════════════════════════════════════════════
// PORTAL ACCESS REQUEST
// Tracks students who need access to the external white-label
// student portal. The portal itself remains the source of truth.
// ═════════════════════════════════════════════════════════════════

enum PortalAccessStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PortalAccessRequest {
  id String @id @default(cuid())

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  demoBookingId String?

  // Canonical CRM identity (C1) — the Lead this portal request
  // belongs to, resolved via the conversation. Nullable; set
  // opportunistically.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  studentName String
  email       String
  phone       String
  course      String?

  status PortalAccessStatus @default(PENDING)

  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  errorMessage  String?
  processedBy   String?

  portalStudentId String?
  portalLogin     String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([demoBookingId])
  @@index([leadId])
}

// ═════════════════════════════════════════════════════════════════
// STAFF
// Counsellors, admins, operators — any human who can own a
// Conversation. A Conversation.assignedCounsellorId FK points here.
// ═════════════════════════════════════════════════════════════════

model Staff {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  role      String   @default("COUNSELLOR") // COUNSELLOR | ADMIN | OPERATOR
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations        Conversation[]        @relation("StaffConversations")
  admissionEnrollments AdmissionEnrollment[]

  // S6-D2-B — demo attendance actions this staff member performed.
  demoAttendanceVerified DemoBooking[]      @relation("StaffDemoAttendanceVerified")
  demoAttendanceActions  DemoBookingEvent[] @relation("StaffDemoAttendanceAction")

  @@index([active])
  @@index([role])
}

// ═════════════════════════════════════════════════════════════════
// RATE LIMIT LOG
// Lightweight table backing lib/ai/rateLimiter.ts when Redis is
// unavailable (dev/fallback) — production should use Redis directly
// for speed, but this keeps a durable audit trail either way.
// ═════════════════════════════════════════════════════════════════

// ═════════════════════════════════════════════════════════════════
// ADMISSION / CONVERSION (S6-B1)
//
// Canonical per-(Lead × coaching course) admission journey — the
// S6-A audit decision, OPTION D:
//
//   · one AdmissionEnrollment row  = canonical CURRENT state
//   · immutable AdmissionEvent rows = full state-transition history
//
// Ownership: Lead × course. NOT conversation-owned, NOT demo-owned.
// One student may have MANY Conversations, DemoBookings and
// PortalAccessRequests but exactly ONE admission record per course.
// The record survives Conversation lifecycle changes — there is no
// FK from an admission record to a conversation.
//
// Absence of a row = NONE (no active conversion journey). A "NONE"
// enum state is deliberately NOT used — no row means no journey.
// ═════════════════════════════════════════════════════════════════

enum AdmissionState {
  INTERESTED
  COUNSELLOR_CONTACT_PENDING
  COUNSELLOR_CONTACTED
  FOLLOW_UP_REQUIRED
  DOCUMENTS_PENDING
  PAYMENT_PENDING
  PAYMENT_VERIFICATION
  PAYMENT_VERIFIED
  ADMISSION_CONFIRMED
  ADMISSION_COMPLETED
  NOT_INTERESTED
  LOST
}

enum AdmissionActor {
  STUDENT
  COUNSELLOR
  ADMIN
  SYSTEM
  AI
}

enum AdmissionEventAction {
  ENROLLMENT_CREATED
  INTEREST_DETECTED
  COUNSELLOR_ASSIGNED
  COUNSELLOR_CONTACTED
  NOTE_ADDED
  FOLLOW_UP_REQUIRED
  FOLLOW_UP_ATTEMPTED
  DOCUMENTS_REQUESTED
  PAYMENT_CLAIMED
  PAYMENT_VERIFICATION_STARTED
  PAYMENT_VERIFIED
  ADMISSION_CONFIRMED
  ADMISSION_COMPLETED
  NOT_INTERESTED
  LOST
  REACTIVATED
  SYSTEM_NOTE
}

model AdmissionEnrollment {
  id String @id @default(cuid())

  // Canonical ownership — one journey per (Lead × coaching course).
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Canonical coaching-course vocabulary — the SAME values as
  // COACHING_COURSES in lib/lead/leadExtractor.ts, reused by
  // lib/demo/demo.offer.ts and lib/lead/counsellor.priority.ts
  // ("IELTS", "PTE", "PTE Academic", "German", "French", "GRE", ...).
  // See lib/admission/admission.lifecycle.ts normalizeAdmissionCourse.
  course String

  state AdmissionState @default(INTERESTED)

  // Counsellor ownership — nullable: an opportunity can exist before
  // anyone is assigned. Assignment is NOT proof the student was
  // contacted — contact is recorded only via an explicit
  // COUNSELLOR_CONTACTED transition, which sets `contactedAt`.
  assignedCounsellorId String?
  assignedCounsellor   Staff?  @relation(fields: [assignedCounsellorId], references: [id], onDelete: SetNull)

  // First explicit counsellor contact (set by COUNSELLOR_CONTACTED).
  // Every other milestone (payment verified, admission confirmed,
  // completed, lost/closed) is DERIVED from the event history, not
  // duplicated as columns — avoids timestamp sprawl.
  contactedAt DateTime?

  // S6-F1 — the counsellor's scheduled NEXT follow-up date (nullable).
  // THE single live "when is the follow-up" value for this canonical
  // journey. Every set/reschedule/clear is ALSO preserved in the
  // immutable AdmissionEvent stream (FOLLOW_UP_REQUIRED /
  // FOLLOW_UP_ATTEMPTED events); this column is only the current derived
  // value used by the CRM due-status (classifyFollowUpStatus) and never
  // an edited-in-place history. Indexed for the overdue/upcoming read
  // derivations on the counsellor queue/workspace surfaces.
  nextFollowUpAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events AdmissionEvent[]

  // CRITICAL — the real DB-level idempotency backstop: at most one
  // admission record per (Lead, course), even under concurrent
  // requests. P2002 on create → resolve to the existing row
  // (see lib/admission/admission.service.ts getOrCreateAdmissionEnrollment).
  @@unique([leadId, course])
  @@index([state])
  @@index([course])
  @@index([assignedCounsellorId])
  @@index([updatedAt])
  @@index([contactedAt])
  @@index([nextFollowUpAt])
}

model AdmissionEvent {
  id String @id @default(cuid())

  admissionEnrollmentId String
  admissionEnrollment   AdmissionEnrollment @relation(fields: [admissionEnrollmentId], references: [id], onDelete: Cascade)

  action AdmissionEventAction

  // Audit payload: what (action + reason), when (createdAt),
  // who/what (actor + actorId), and the state walk
  // (previousState → nextState; previousState is null for creation).
  previousState AdmissionState?
  nextState     AdmissionState

  actor   AdmissionActor
  actorId String?

  reason String?

  // Idempotency backstop for a LOGICAL action. Postgres unique indexes
  // treat NULL as distinct, so events carrying `eventKey = null` (notes,
  // repeatable occurrences) are always inserted, while events sharing
  // (admissionEnrollmentId, eventKey) — concurrent OR sequential —
  // collapse to ONE row. Keys are built deterministically by the pure
  // domain module (lib/admission/admission.lifecycle.ts); callers pass
  // a `discriminator` only when a genuinely later repeat of the same
  // logical action must be recorded as a NEW event.
  eventKey String?

  createdAt DateTime @default(now())

  @@unique([admissionEnrollmentId, eventKey])
  @@index([admissionEnrollmentId, createdAt])
  @@index([action])
}

// ═════════════════════════════════════════════════════════════════
// RATE LIMIT LOG
// Lightweight table backing lib/ai/rateLimiter.ts when Redis is
// unavailable (dev/fallback) — production should use Redis directly
// for speed, but this keeps a durable audit trail either way.
// ═════════════════════════════════════════════════════════════════

model RateLimitLog {
  id         String   @id @default(cuid())
  identifier String // IP address or phone number
  endpoint   String // e.g. "/api/chat"
  createdAt  DateTime @default(now())

  // Single-row-per-(identifier,endpoint) window counter (C1). The
  // chat limiter now upserts ONE row per key and increments
  // `requestCount` within the fixed window, instead of appending one
  // row per request — this is what makes `@@unique` below safe (and
  // it also makes idempotency claim inserts (wa-msg:/cw-msg: keys)
  // race-safe: a unique violation means "already claimed").
  requestCount Int @default(1)

  @@unique([identifier, endpoint])
  @@index([identifier, endpoint, createdAt])
}
